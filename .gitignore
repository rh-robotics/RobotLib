# Ignore Gradle project-specific cache directory
.gradle

# Ignore local IDE configuration files
.idea
*.iml
.vscode

# Ignore Gradle build output directory
build

# Ignore local properties file which may contain sensitive information
local.properties

# Ignore build log generated by Android Studio / Gradle
build.log

# Ignore macOS metadata files
.DS_Store

# Ignore the Gradle wrapper JAR - it's a binary that should be fetched by the wrapper script
# (comment this out if your team policy is to commit it for reproducibility)
# gradle/wrapper/gradle-wrapper.jar

